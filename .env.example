# OpenRouter key (server-side only; never sent to the browser). Leave empty with MOCK_OPENAI=1.
# Set a credit limit on the key in the OpenRouter dashboard as a second kill switch next to DAILY_BUDGET_USD.
OPENROUTER_API_KEY=
# Optional app attribution in the OpenRouter dashboard (HTTP-Referer / X-Title headers)
OPENROUTER_APP_URL=
OPENROUTER_APP_NAME=WealthQuest Support
# deny = only providers that don't keep or train on the data (default); allow = any provider
OPENROUTER_DATA_COLLECTION=deny
# 1 = zero-data-retention endpoints only. Check OpenAI's endpoints on OpenRouter are ZDR first, or every request fails.
OPENROUTER_ZDR=0
# 1 = fake, deterministic streamed answers + realistic fake usage (no key needed)
MOCK_OPENAI=0
# Password for the whole demo (empty = no gate)
DEMO_PASSWORD=
# Signs the session / gate cookies. Use a long random string in production: openssl rand -hex 32
SESSION_SECRET=
# Hard daily AI spend limit across all users (USD). Requests are refused once reached.
DAILY_BUDGET_USD=5
# Optional Cloudflare Turnstile. If TURNSTILE_SECRET is set, the first message of every conversation
# must carry a valid token (the frontend loads the Turnstile widget automatically when the site key is set).
TURNSTILE_SECRET=
TURNSTILE_SITE_KEY=
# Main-app origins allowed to frame /embed, comma-separated (e.g. https://app.wealthquest.com).
# Unset: http://localhost:3333 + http://localhost:3334 in development, nobody in production.
ALLOWED_PARENT_ORIGINS=
# 1 = demo-only parts: the simulated Back Office (Maria), the mock WealthQuest API and the Compensation agent.
# Unset: on in development, off when NODE_ENV=production.
DEMO_MODE=
# The WealthQuest main app (e.g. https://app.wealthquest.com). Outside demo mode, "Log in" points at its /login.
MAIN_APP_URL=
# Member sign-in: the main app's issuer (its APP_URL). Unset = everyone is a guest.
# WQ_JWKS_URL defaults to $WQ_ISSUER/.well-known/jwks.json; WQ_AUDIENCE defaults to wq-ai-support.
WQ_ISSUER=
WQ_JWKS_URL=
WQ_AUDIENCE=
# Shared with the main app: signs tickets forwarded to MAIN_APP_URL/internal/ai/tickets.
# With MAIN_APP_URL + this set, tickets go to the main app; otherwise to data/tickets.jsonl (refused in production).
AI_SUPPORT_SERVICE_SECRET=
PORT=3000
