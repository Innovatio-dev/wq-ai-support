# OpenAI key (server-side only; never sent to the browser). Leave empty with MOCK_OPENAI=1.
OPENAI_API_KEY=
# 1 = fake, deterministic streamed answers + realistic fake usage (no key needed)
MOCK_OPENAI=0
# Password for the whole demo (empty = no gate)
DEMO_PASSWORD=
# Signs the session / gate cookies. Use a long random string in production: openssl rand -hex 32
SESSION_SECRET=
# Hard daily AI spend limit across all users (USD). Requests are refused once reached.
DAILY_BUDGET_USD=5
# Optional Cloudflare Turnstile. If TURNSTILE_SECRET is set, the first message of every conversation
# must carry a valid token (the frontend loads the Turnstile widget automatically when the site key is set).
TURNSTILE_SECRET=
TURNSTILE_SITE_KEY=
PORT=3000
